# Neon PostgreSQL — keep server-side, never commit real credentials
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Single-owner admin login (phase 2)
ADMIN_EMAIL=
# Generate interactively: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
# Generate at least 32 random characters, never share or commit
ADMIN_SESSION_SECRET=

# Customer transactional emails (Phase 4)
# Leave disabled until db/004_email_notifications.sql is applied,
# your sending domain is verified, and all following values are configured.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Sunidhi Artistry <bookings@your-owned-domain.com>
# Optional: verified address for replies, e.g. the studio's existing inbox
EMAIL_REPLY_TO=
